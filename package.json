{
	"name": "totp-autofill-extension",
	"version": "1.0.0",
	"private": true,
	"description": "Offline, encrypted TOTP authenticator and autofill extension for Google Chrome.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/womesiete/totp-autofill-extension.git"
	},
	"scripts": {
		"clean": "node ./scripts/clean.mjs",
		"build": "webpack --mode production",
		"build:development": "webpack --mode development",
		"watch": "webpack --mode development --watch",
		"test": "node --test",
		"check": "node ./scripts/check-source.mjs",
		"validate": "npm run check && npm test && npm run build"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"otplib": "13.4.1"
	},
	"devDependencies": {
		"copy-webpack-plugin": "14.0.0",
		"webpack": "5.109.2",
		"webpack-cli": "7.2.2"
	}
}
