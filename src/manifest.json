{
	"manifest_version": 3,
	"name": "TOTP Autofill",
	"version": "1.0",
	"description": "Autofills TOTP codes on matched URLs.",
	"permissions": [
		"storage",
		"activeTab",
		"clipboardWrite",
		"scripting"
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}